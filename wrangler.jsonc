{
  "$schema": "node_modules/wrangler/config-schema.json",
  // El nombre define la URL: https://crea-tu-rifa.<tu-cuenta>.workers.dev
  "name": "crea-tu-rifa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "observability": { "enabled": true },
  // Sin esto, cada `wrangler deploy` borra las variables de texto creadas en el panel.
  "keep_vars": true
  // SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY van como secretos de runtime del Worker
  // (Settings → Variables and Secrets, tipo Secret), no como variables de build:
  //   npx wrangler secret put SUPABASE_URL
  //   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
}
